{"at": "2026-11-04T00:20:59.879Z", "run": "20261103-1637-expand-netdisk-pan-9a0e", "unit": "u05", "op": "set", "rid": "netdisk-pan/1yunpan", "path": "$.per_object_cap.stated", "old": "Not published", "new": "32212254720 bytes (30 GiB) per upload, as the site's published config.json sets limit.upload_allow_max_size", "rung": "measured", "evidence": {"url": "probe:https://www.1yunpan.com/config.json", "date": "2026-11-03", "proved": "the site config sets the per-upload size limit to 32212254720 bytes", "capture": "sha256:6ce2e8085f6efcb6680948e05ef4cd11edc846997f85dc9948a0f5210d19570d", "quote": "\"upload_allow_max_size\": 32212254720"}, "added": true, "reason": "the record said not published; the config the web app loads states the limit"}
